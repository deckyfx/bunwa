# Neutralises the development switches for the test suite.
#
# Bun auto-loads .env for every process including `bun test`, so turning
# ADMIN_API_ENABLED on for local development silently turned it on for 23
# tests — several of which construct a production Config and assert it
# refuses. The failure named the admin API rather than the .env that caused
# it.
#
# Values here override .env per key; anything absent still falls through, so
# this file lists only what a test must not inherit.
ADMIN_API_ENABLED=false
BAILEYS_ENABLED=false
CREDENTIAL_ENCRYPTION_KEY=

# Pinned so an assertion on a rendered timestamp is testing the code and not
# whatever the default happens to be this month.
SERVER_TIMEZONE=Asia/Jakarta

# The suite must not append to the log directory a developer is tailing. Tests
# that care about the file sink point LOG_DIR at a temp directory of their own.
LOG_DIR=./data/logs-test
