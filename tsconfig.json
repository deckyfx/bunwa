{
  "compilerOptions": {
    // Environment setup & latest features
      // DOM because the console lives in src/console and runs in a browser. One
  // tsconfig now that the dashboard is not a separate subproject — the server
  // does not use these types, and a second config to express that was more
  // upkeep than the separation was worth.
  "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": false
  },

  "include": ["src"],

  "exclude": ["node_modules", "dist"]
}
