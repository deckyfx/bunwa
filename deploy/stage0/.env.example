# gowa configuration for the stage 0 measurement harness.
APP_PORT=3000
APP_HOST=0.0.0.0
APP_DEBUG=false
APP_OS=bunwa-stage0
APP_BASIC_AUTH=
# Local-only harness: gowa is published on 127.0.0.1 and sits behind no proxy,
# so the range is irrelevant here. Never carry this value into a deployment.
APP_TRUSTED_PROXIES=0.0.0.0/0
APP_CORS_ALLOWED_ORIGINS=

# Dashboard on, so pairing can be done in a browser.
APP_UI_ENABLED=true
APP_UI_AUTO_UPDATE=true

DB_URI=file:storages/whatsapp.db?_foreign_keys=on

# Webhooks point at the host-side sink (src/tools/stage0/sink.ts).
WHATSAPP_WEBHOOK=http://host.docker.internal:3999/hook
# Deliberately a known value, matching the sink's default so the runbook works
# on a fresh clone. It signs traffic between two local processes and protects
# nothing of value. Never carry this pattern into anything deployed.
WHATSAPP_WEBHOOK_SECRET=stage0-secret

# Requirement F4b: calls must be ignored, never rejected. This is the default;
# it is set explicitly here so the measurement proves the intended config.
WHATSAPP_AUTO_REJECT_CALL=false

# No auto-reply: bunwa's rule engine replaces it.
WHATSAPP_AUTO_REPLY=
WHATSAPP_AUTO_MARK_READ=false
WHATSAPP_AUTO_DOWNLOAD_MEDIA=true
WHATSAPP_ACCOUNT_VALIDATION=false
