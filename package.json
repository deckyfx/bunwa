{
  "name": "bunwa",
  "version": "0.0.1",
  "description": "Bun/TypeScript rewrite of gowa (WhatsApp Web multi-device API)",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "dashboard"
  ],
  "scripts": {
    "dev": "bun --watch run src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit && cd dashboard && tsc --noEmit",
    "test": "bun test && cd dashboard && bun test",
    "db:generate": "drizzle-kit generate && bun run scripts/embed-migrations.ts",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:embed": "bun run scripts/embed-migrations.ts",
    "build": "bun run db:embed && bun run typecheck && bun build --compile --outfile dist/bunwa src/index.ts",
    "backup": "bun run src/ops/backup-cli.ts",
    "dashboard:dev": "cd dashboard && bun run dev"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29"
  }
}
