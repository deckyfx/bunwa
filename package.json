{
  "name": "bunwa",
  "version": "0.0.1",
  "description": "Bun/TypeScript rewrite of gowa (WhatsApp Web multi-device API)",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch run src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate && bun run scripts/embed-migrations.ts",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:purge": "bun run src/ops/purge-cli.ts",
    "db:studio": "drizzle-kit studio",
    "db:embed": "bun run scripts/embed-migrations.ts",
    "build": "bun run db:embed && bun run typecheck && bun build --compile --outfile dist/bunwa src/index.ts",
    "backup": "bun run src/ops/backup-cli.ts",
    "dev:headless": "bun --watch run src/index-headless.ts",
    "start:headless": "bun run src/index-headless.ts",
    "key:list": "bun run src/ops/key-cli.ts list",
    "key:new": "bun run src/ops/key-cli.ts new",
    "key:revoke": "bun run src/ops/key-cli.ts revoke"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "lucide-react": "^1.34.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bun-plugin-tailwind": "^0.1.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2"
  }
}
