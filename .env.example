# Copy to .env and adjust. Every value here is the documented default except
# DATABASE_URL, which is required.

# development | test | production
NODE_ENV=development

# Server
HOST=0.0.0.0
PORT=3000

# debug | info | warn | error  (defaults to info in production, debug otherwise)
LOG_LEVEL=debug

# Required. Postgres connection string.
DATABASE_URL=postgres://bunwa:bunwa@localhost:5432/bunwa

# Refuse to start when migrations are pending, rather than applying them.
# Defaults to true in production, false otherwise.
MIGRATE_STRICT=false
