# Copy to .env and adjust. Every value here is the documented default, so an
# empty .env behaves identically — but a variable that is present must be
# valid: blank and malformed values are rejected rather than defaulted.

# development | test | production
NODE_ENV=development

# Server
HOST=0.0.0.0
PORT=3000

# debug | info | warn | error  (defaults to info in production, debug otherwise)
LOG_LEVEL=debug

# SQLite file. A bare path, a file: URL, or :memory:. Created on first run.
DATABASE_PATH=./data/db/bunwa.sqlite

# Refuse to start when migrations are pending, rather than applying them.
# Defaults to true in production, false otherwise.
MIGRATE_STRICT=false

# Writable directory for runtime state — chiefly the migrations materialised
# out of the binary. Ephemeral; nothing here is a source of truth.
RUNTIME_DIR=.runtime

# Mount the admin API. It can mint API keys and has no authentication yet, so
# enabling it is a deliberate act. Never true in a deployment until §1.3 grows
# operator sessions.
ADMIN_API_ENABLED=false

# Permit webhook targets that are plain http, or private/loopback addresses.
# Its own switch rather than derived from NODE_ENV: a security control must not
# be disabled by an unset environment name. Rejected outright in production.
ALLOW_INSECURE_WEBHOOK_TARGETS=false

# Where the colocated gowa engine listens. Empty disables the engine entirely,
# which is correct for a process that only runs migrations or the admin API.
GOWA_BASE_URL=

# Devices per engine pool. Bounds the blast radius of one pool failing.
ENGINE_POOL_CAPACITY=25
